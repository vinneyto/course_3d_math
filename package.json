{
  "name": "practical-3d-math",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["exercises", "sandbox", "slides"],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "demo": "node sandbox/start-demo.mjs",
    "test": "vitest run --config exercises/vitest.config.ts",
    "test:watch": "vitest --config exercises/vitest.config.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w slides",
    "dev": "npm run dev -w slides",
    "build": "npm run build -w slides && npm run build -w sandbox",
    "test:slides": "npm run test -w slides",
    "test:e2e": "npm run test:e2e -w slides"
  },
  "dependencies": {
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "typescript": "^6.0.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
